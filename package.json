{
  "name": "devlab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @devlab/web dev",
    "dev:api": "pnpm --filter @devlab/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
