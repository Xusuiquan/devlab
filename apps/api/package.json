{
  "name": "@devlab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "pnpm test:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:unit": "pnpm test --testPathPatterns=src/",
    "test:e2e": "pnpm test --testPathPatterns=test/"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "typescript": "~6.0.2"
  }
}
